# Application Settings
APP_NAME=NutriAI
APP_ENV=development
DEBUG=True

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# ========================================
# ОБХОД ГЕОБЛОКИРОВКИ (только для VDS в России!)
# ========================================
# Если ваш VDS за пределами России (США, Европа, Азия) - оставьте эти параметры пустыми или закомментируйте!
# Claude API блокирует запросы из России, поэтому нужен один из вариантов:

# Вариант 1: Cloudflare Worker (рекомендуется для облачных сервисов)
# Инструкция: см. CLOUDFLARE_WORKER_SETUP.md
# Пример: https://claude-api-proxy.your-subdomain.workers.dev
# CLOUDFLARE_WORKER_URL=

# Вариант 2: WARP Proxy (рекомендуется для VDS/VPS)
# Сначала установите Cloudflare WARP, затем укажите прокси
# Для Linux/Windows: socks5://127.0.0.1:40000
# WARP_PROXY_URL=

# ВАЖНО: Используйте ТОЛЬКО ОДИН вариант! Если оба закомментированы - прямое подключение к Claude API

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://nutriai:nutriai@localhost:5432/nutriai

# PostgreSQL Settings (for docker-compose)
POSTGRES_USER=nutriai
POSTGRES_PASSWORD=nutriai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nutriai

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Data Protection (152-ФЗ - Personal Data Law)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-generate-with-command-above

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Rate Limiting (for Free users)
FREE_PHOTO_LIMIT_PER_DAY=5
FREE_CHAT_LIMIT_PER_DAY=10

# Logging
LOG_LEVEL=INFO
